# 数据库配置
# 方式一：直接提供完整 URL（与下面拆分字段二选一）
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/dbname
# 方式二：拆分字段（DATABASE_PASSWORD 必填，不提供默认值）
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=domefff
DATABASE_USER=postgres
# 必填：禁止使用写死的默认密码，必须从环境变量设置
DATABASE_PASSWORD=CHANGE_ME_TO_REAL_PASSWORD
# 连接池（生产参数，均有默认值；高并发可调大 pool_size/max_overflow）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=True

# 应用配置
PROJECT_NAME=FastAPI RBAC Framework
API_V1_STR=/api/v1
# 应用统一时区（IANA 名称）。影响：展示层（日志、错误响应 timestamp）按此时区呈现。
# 存储层（数据库、JWT）一律 UTC，保证跨时区一致性。
# 非 UTC 时区依赖 tzdata 包（已在 requirements.txt）；缺失会启动报"时区非法"。
# 跨境部署可改 UTC 或其它 IANA 名（如 America/New_York）。
TIMEZONE=Asia/Shanghai
# 生产环境建议置 False，改用 alembic upgrade head 管理建表
DB_AUTO_CREATE=False
# 启动时若目标库不存在则自动创建（连维护库执行 CREATE DATABASE）；生产可置 False
DB_AUTO_CREATE_DATABASE=True
DB_MAINTENANCE_DB=postgres
# 启动时自动执行 alembic upgrade head（建表/升级到最新）。仅在 DB_AUTO_CREATE=False 时生效。
# 默认 True：单实例/开发省事。多实例/多 worker 生产置 False，改用独立 migration 步骤 + 启动版本检查，
# 避免并发 upgrade 竞态。
DB_AUTO_MIGRATE=True
# 使用以下Python命令生成安全的密钥:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=GENERATE_SECURE_KEY_HERE
ALGORITHM=HS256
# access token 短期化（分钟）；配合下面的 refresh token 使用
ACCESS_TOKEN_EXPIRE_MINUTES=15
# refresh token 有效期（天）；/auth/refresh 用它换取新的 access token
REFRESH_TOKEN_EXPIRE_DAYS=7
# access token 黑名单后端（登出/改密后让未过期 access token 立即失效）
#   memory=未配置 Redis 时回退进程内（默认，单实例） / open=Redis 故障时放行（不推荐）
TOKEN_BLACKLIST_FALLBACK=memory

# 默认管理员（仅首次初始化创建）
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# 设置了值 = 用该密码（不写日志）；留空 = 首启随机生成强密码并在日志提示一次
ADMIN_PASSWORD=admin123

# 一键鉴权开关：False=所有接口视为超级用户放行（仅本地开发，且只在 DEBUG=True 下允许）
AUTH_ENABLED=True

# CORS配置 - 生产环境应该限制为特定域名
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=*

# 速率限制配置
RATE_LIMIT_CALLS=100
RATE_LIMIT_PERIOD=60
AUTH_RATE_LIMIT_CALLS=5
AUTH_RATE_LIMIT_PERIOD=60

# Redis（可选）：配置后限流改用 Redis 实现跨实例一致
# 留空 = 纯内存模式（单实例）；多 worker / 多实例部署强烈建议配置
# REDIS_URL=redis://:password@localhost:6379/0
REDIS_SOCKET_TIMEOUT=0.5
# Redis 不可用时的降级策略：memory=降级内存限流(默认) / open=直接放行
RATE_LIMIT_FALLBACK=memory
RATE_LIMIT_REDIS_RETRY_INTERVAL=5.0
# 通用缓存降级策略：memory=退回进程内缓存(默认) / off=不命中且不写入
CACHE_FALLBACK=memory

# 异步任务队列（arq，可选模块；默认关闭）
# False / 未配 REDIS_URL / 未装 arq 时，enqueue() 就地同步执行（eager），功能不丢只是不异步。
# 启用：pip install -r requirements-queue.txt + 置 True + 配 REDIS_URL + 起 worker（见 docs/system/queue.md）
QUEUE_ENABLED=False

# 可观测性 OpenTelemetry（可选，默认关闭）
# OTEL_ENABLED=False 时完全 no-op；启用后自动埋点 FastAPI/SQLAlchemy/Redis，
# traces + metrics（含延迟直方图，可算 p95/p99）经 OTLP 导出到 collector。
OTEL_ENABLED=False
OTEL_SERVICE_NAME=fastapi-rbac-framework
# OTLP collector 端点；留空且启用 = 降级为控制台导出（仅本地调试）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# 采样率 0.0~1.0；生产高流量可调小（如 0.1）
OTEL_TRACES_SAMPLER_RATIO=1.0
# 强制控制台导出（本地调试，优先于 OTLP）
OTEL_CONSOLE_EXPORT=False

# 日志配置 - 生产级
# LOG_PROFILE=prod 自动设置：INFO + JSON 序列化 + 文件轮转 + 独立 error 日志
# 注释掉的字段用 prod 默认值；取消注释则覆盖默认
DEBUG=False
LOG_PROFILE=prod
LOG_DIR=logs
LOG_ROTATION=10 MB
LOG_RETENTION=30 days
# LOG_LEVEL=INFO
# LOG_SERIALIZE=True
# LOG_BACKTRACE=False
# LOG_ENABLE_CONSOLE=True
# LOG_ENABLE_FILE=True
# LOG_ENABLE_ERROR_FILE=True
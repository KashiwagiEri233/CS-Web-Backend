# 数据库配置
# 方式一：直接提供完整 URL（与下面拆分字段二选一）
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/dbname
# 方式二：拆分字段（DATABASE_PASSWORD 必填，不提供默认值）
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=domefff
DATABASE_USER=postgres
# 必填：禁止使用写死的默认密码，必须从环境变量设置
DATABASE_PASSWORD=CHANGE_ME_TO_REAL_PASSWORD
# 连接池（生产参数，均有默认值；高并发可调大 pool_size/max_overflow）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=True

# 应用配置
PROJECT_NAME=FastAPI RBAC Framework
API_V1_STR=/api/v1
# 应用统一时区（IANA 名称）。影响：展示层（日志、错误响应 timestamp）按此时区呈现。
# 存储层（数据库、JWT）一律 UTC，保证跨时区一致性。
# 非 UTC 时区依赖 tzdata 包（已在 requirements.txt）；缺失会启动报"时区非法"。
# 跨境部署可改 UTC 或其它 IANA 名（如 America/New_York）。
TIMEZONE=Asia/Shanghai
# Schema 一律由 Alembic 管理（create_all 与 DB_AUTO_CREATE 已移除）
# 启动时若目标库不存在则自动创建（连维护库执行 CREATE DATABASE）；生产可置 False
DB_AUTO_CREATE_DATABASE=True
DB_MAINTENANCE_DB=postgres
# 启动时自动执行 alembic upgrade head（建表/升级到最新）。
# True：空库启动自动迁移。多实例生产可置 False，改用独立 migration 步骤 + 启动版本检查。
DB_AUTO_MIGRATE=False
# 使用以下Python命令生成安全的密钥:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=GENERATE_SECURE_KEY_HERE
ALGORITHM=HS256
JWT_ISSUER=fastapi-witchcat-framework
JWT_AUDIENCE=fastapi-witchcat-api
# 旧 token 迁移窗口结束后必须关闭；新部署直接 False
JWT_ACCEPT_LEGACY_TOKENS=False
PERSIST_CLIENT_ERRORS=False
EXCEPTION_LOG_RETENTION_DAYS=30
EXCEPTION_LOG_CLEANUP_INTERVAL_SECONDS=86400
# access token 短期化（分钟）；配合下面的 refresh token 使用
ACCESS_TOKEN_EXPIRE_MINUTES=15
# refresh token 有效期（天）；/auth/refresh 用它换取新的 access token
REFRESH_TOKEN_EXPIRE_DAYS=7
# refresh 轮换宽限窗口（秒）：窗口内重用已撤销 refresh 视为并发重试放行；0=复用即吊销 family
REFRESH_TOKEN_ROTATION_LEEWAY_SECONDS=10
# access token 黑名单后端（登出/改密后让未过期 access token 立即失效）
#   closed=Redis 故障时拒绝 access token（生产推荐） / memory=进程内 / open=放行
TOKEN_BLACKLIST_FALLBACK=closed
# True 时：必须配置 REDIS_URL；启动 ping 失败拒绝启动；并强制 TOKEN_BLACKLIST_FALLBACK=closed
# 用于多 worker 撤销状态一致（fail-closed，禁止静默降级到进程内存）
REQUIRE_REDIS_FOR_SECURITY=True

# 默认管理员（仅首次初始化创建）
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# 首次创建管理员时必填；已有管理员后可留空。密码永不写日志
ADMIN_PASSWORD=

# 一键鉴权开关：False=所有接口视为超级用户放行（仅本地开发，且只在 DEBUG=True 下允许）
AUTH_ENABLED=True
# 交互式文档（/docs、/redoc、/openapi.json）。留空=跟随 DEBUG（生产自动关闭，
# 避免未认证用户拿到完整 API 结构）；需要在生产开放时显式置 True
# ENABLE_API_DOCS=False

# CORS配置 - 生产环境应该限制为特定域名
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=*
# 可信反向代理 IP/CIDR，逗号分隔；留空时忽略所有 X-Forwarded-For/X-Real-IP
TRUSTED_PROXY_CIDRS=

# 速率限制配置
RATE_LIMIT_CALLS=100
RATE_LIMIT_PERIOD=60
AUTH_RATE_LIMIT_CALLS=5
AUTH_RATE_LIMIT_PERIOD=60
# 请求体大小上限（字节）。uvicorn 不限制请求体，缺这道闸门时超大 JSON 会被完整读进内存
MAX_REQUEST_BODY_BYTES=1048576

# Redis（可选）：配置后限流改用 Redis 实现跨实例一致
# 留空 = 纯内存模式（单实例）；多 worker / 多实例部署强烈建议配置
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
REDIS_SOCKET_TIMEOUT=0.5
# 连接池上限（redis-py 默认不限，Redis 故障时连接会堆积到打满 maxclients）
REDIS_MAX_CONNECTIONS=50
# 空闲连接取用前 PING 的间隔（秒），剔除被中间设备静默掐断的死连接；0=关闭
REDIS_HEALTH_CHECK_INTERVAL=30
# Redis 不可用时的降级策略：memory=降级内存限流(默认) / open=直接放行
RATE_LIMIT_FALLBACK=memory
RATE_LIMIT_REDIS_RETRY_INTERVAL=5.0
# 通用缓存降级策略：memory=退回进程内缓存(默认) / off=不命中且不写入
CACHE_FALLBACK=memory

# 异步任务队列（arq，可选模块；默认关闭）
# False / 未配 REDIS_URL / 未装 arq 时，enqueue() 就地同步执行（eager），功能不丢只是不异步。
# 启用：pip install -r requirements-queue.txt + 置 True + 配 REDIS_URL + 起 worker（见 docs/system/queue.md）
QUEUE_ENABLED=False

# 可观测性 OpenTelemetry（可选，默认关闭）
# OTEL_ENABLED=False 时完全 no-op；启用后自动埋点 FastAPI/SQLAlchemy/Redis，
# traces + metrics（含延迟直方图，可算 p95/p99）经 OTLP 导出到 collector。
OTEL_ENABLED=False
OTEL_SERVICE_NAME=fastapi-rbac-framework
# OTLP collector 端点；留空且启用 = 降级为控制台导出（仅本地调试）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# 采样率 0.0~1.0；生产高流量可调小（如 0.1）
OTEL_TRACES_SAMPLER_RATIO=1.0
# 强制控制台导出（本地调试，优先于 OTLP）
OTEL_CONSOLE_EXPORT=False

# 日志配置 - 生产级
# LOG_PROFILE=prod 自动设置：INFO + JSON 序列化 + 文件轮转 + 独立 error 日志
# 注释掉的字段用 prod 默认值；取消注释则覆盖默认
DEBUG=False
TESTING=False
LOG_PROFILE=prod
LOG_DIR=logs
LOG_ROTATION=10 MB
LOG_RETENTION=30 days
# LOG_LEVEL=INFO
# LOG_SERIALIZE=True
# LOG_BACKTRACE=False
# LOG_ENABLE_CONSOLE=True
# LOG_ENABLE_FILE=True
# LOG_ENABLE_ERROR_FILE=True
# 异步落盘：prod 默认 True（后台线程写 sink，避免同步磁盘 IO 阻塞事件循环）
# LOG_ENQUEUE=True
# 密钥轮换：旧 SECRET_KEY 逗号分隔，校验时回退
JWT_PREVIOUS_SECRET_KEYS=
REFRESH_TOKEN_GC_INTERVAL_SECONDS=3600


# ---- 站点 / 业务配置（前后端分离迁移 Phase 1） ----
# 站点公网地址（BFF 域名），用于构造 OAuth 回调等默认 URL
SITE_URL=http://localhost:2333

# TOTP 2FA：secret 加密密钥（>=32 UTF-8 字节，必填；生成: python -c "import secrets; print(secrets.token_urlsafe(32))"）
TOTP_ENCRYPTION_KEY=CHANGE_ME_TOTP_ENCRYPTION_KEY
TOTP_ISSUER=FZTBUCS
# TOTP 时间步长与时钟偏移窗口（步）
# TOTP_STEP_SECONDS=30
# TOTP_WINDOW_STEPS=1
# 2FA 预认证 token 有效期（分钟）
# TOTP_PRE_AUTH_TTL_MINUTES=5

# 邮箱验证码有效期（分钟）
# VERIFICATION_CODE_TTL_MINUTES=10
# 密码历史复用检测（N 条；0=禁用）
# PASSWORD_HISTORY_LIMIT=5
# 管理员批准重置时使用的默认密码（必填，无回退；与前端 PASSWORD_RESET_DEFAULT 对齐）
PASSWORD_RESET_DEFAULT=CHANGE_ME_RESET_PASSWORD

# SMTP 邮件（SMTP_HOST 为空时回退控制台输出）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=False
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@fztbu.example
# SMTP_TLS_SKIP_VERIFY=False

# GitHub OAuth（未配置 CLIENT_ID 时 OAuth 登录入口返回未启用）
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=

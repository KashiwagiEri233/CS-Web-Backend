# ============ CS-Web-Backend .gitignore ============
# 公共段与根级 / 前端共享同一套规范；下方为本项目 Python 后端专属忽略项。

# ---- 公共段（根级 / 后端 / 前端 三者一致）----

# 环境变量（密钥不入库；模板 .env.example 需提交）
.env
.env.local
.env.*.local
.env.development

# 日志
*.log

# 开发日志目录（含非 .log 文件时整体排除）
.devlogs/

# 本地 dev 后台进程 PID 文件（make dev-up 生成，dev-down 清理）
.dev.pid

# IDE / 编辑器 / 工具数据
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.codebuddy/
.trae-cn/
.workbuddy/

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
._*

# 运行时数据 / 备份（由 compose 卷挂载到根级 data/ backups/）
data/
backups/

# Redis 快照（运行时数据；可能含会话态，不入库）
dump.rdb
*.rdb
appendonlydir/

# 注：pgdata / caddy_data / caddy_config 等为 Docker 命名卷，由 Docker 管理，
# 不落在工作区目录，无需在此忽略。

# ---- Python 专属段 ----

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Django stuff:
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# pipenv
Pipfile.lock

# PEP 582
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments（生产/本机密钥文件不入库；开发/测试模板可跟踪）
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# IDE
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Alembic：迁移脚本是 schema 的版本化资产，必须提交（线上靠它建表）！只忽略缓存。
alembic/versions/__pycache__/

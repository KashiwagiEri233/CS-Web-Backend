# 开发环境配置
# 复制为 .env 使用：cp .env.development .env

# 数据库配置（开发环境，专属库 domefff）
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=domefff
DATABASE_USER=postgres
DATABASE_PASSWORD=123456
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost/domefff

# 应用配置
PROJECT_NAME=FastAPI RBAC Framework
API_V1_STR=/api/v1
# 使用以下Python命令生成安全的密钥:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-key-not-for-production-use-only
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 默认管理员（首次初始化创建）
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# CORS配置
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=*

# 速率限制配置（开发环境可放宽）
RATE_LIMIT_CALLS=100
RATE_LIMIT_PERIOD=60
AUTH_RATE_LIMIT_CALLS=5
AUTH_RATE_LIMIT_PERIOD=60

# 日志配置 - 开发级
# LOG_PROFILE=dev 自动设置：DEBUG + 彩色控制台 + 完整回溯栈 + 无文件
# 注释掉的字段用 dev 默认值；取消注释则覆盖默认
# 例如开发时也想要文件日志：取消注释 LOG_ENABLE_FILE=True
DEBUG=True
LOG_PROFILE=dev
LOG_DIR=logs
LOG_ROTATION=10 MB
LOG_RETENTION=30 days
# LOG_LEVEL=DEBUG
# LOG_SERIALIZE=False
# LOG_BACKTRACE=True
# LOG_ENABLE_CONSOLE=True
# LOG_ENABLE_FILE=False
# LOG_ENABLE_ERROR_FILE=False

# 开发环境配置（.env.development）
# `python run.py`（不带参数）默认加载本文件。
# 本文件是**最全的参考样板**：所有可配字段都在此列出；新增配置项必须同步到这里。
# 复制为 .env 使用：cp .env.development .env

# ============ 数据库（开发，专属库 domefff）============
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=domefff
DATABASE_USER=postgres
DATABASE_PASSWORD=123456
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost/domefff
# 开发环境用 create_all 自动建表/建库；生产置 False 改走 alembic
DB_AUTO_CREATE=True
DB_AUTO_CREATE_DATABASE=True
DB_MAINTENANCE_DB=postgres

# ============ 应用 ============
PROJECT_NAME=FastAPI RBAC Framework
API_V1_STR=/api/v1
DEBUG=True
# 一键鉴权开关：False=跳过所有鉴权，所有接口视为超级用户（仅本地开发）
# 安全约束：DEBUG=False 时置 False 会拒绝启动
AUTH_ENABLED=True

# ============ JWT ============
# 生成安全密钥: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-key-not-for-production-use-only
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# access token 黑名单后端降级：memory=回退进程内(默认) / open=Redis故障时放行(不推荐)
TOKEN_BLACKLIST_FALLBACK=memory

# ============ 默认管理员（首次初始化创建）============
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# 留空=首启随机生成强密码并在日志提示一次；设值=用该密码且不写日志
ADMIN_PASSWORD=admin123

# ============ CORS ============
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=*

# ============ 速率限制（开发可放宽）============
RATE_LIMIT_CALLS=100
RATE_LIMIT_PERIOD=60
AUTH_RATE_LIMIT_CALLS=5
AUTH_RATE_LIMIT_PERIOD=60

# ============ Redis（限流/缓存分布式后端，可降级）============
# 本地默认连接，无密码；若本机未起 Redis，会自动降级为内存模式（仅一条 warning，不阻断启动）。
# 用 127.0.0.1 而非 localhost：Windows 上 localhost 优先解析到 IPv6 ::1，
#   而 Redis 默认只监听 IPv4(0.0.0.0)，叠加 REDIS_SOCKET_TIMEOUT=0.5 会直接 "Timeout connecting"。
# 带密码写法：redis://:yourpassword@127.0.0.1:6379/0
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SOCKET_TIMEOUT=0.5
# Redis 不可用时：memory=降级内存(默认) / open=直接放行
RATE_LIMIT_FALLBACK=memory
RATE_LIMIT_REDIS_RETRY_INTERVAL=5.0
# 缓存降级：memory=退回进程内(默认) / off=不命中且不写入
CACHE_FALLBACK=memory

# ============ 异步任务队列（arq，可选模块，默认关闭）============
# 由队列模块自读（不在核心 Settings）。True 需另装 requirements-queue.txt 并起 worker，见 docs/system/queue.md
QUEUE_ENABLED=False

# ============ 可观测性（OpenTelemetry，可选，默认关闭）============
OTEL_ENABLED=False
OTEL_SERVICE_NAME=fastapi-rbac-framework
# OTLP collector 端点；留空+启用=降级控制台导出
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER_RATIO=1.0
OTEL_CONSOLE_EXPORT=False

# ============ 日志（开发级）============
# LOG_PROFILE=dev 自动设置：DEBUG + 彩色控制台 + 完整回溯栈 + 无文件
# 注释掉的字段用 dev 默认值；取消注释则覆盖
LOG_PROFILE=dev
LOG_DIR=logs
LOG_ROTATION=10 MB
LOG_RETENTION=30 days
# LOG_LEVEL=DEBUG
# LOG_SERIALIZE=False
# LOG_BACKTRACE=True
# LOG_ENABLE_CONSOLE=True
# LOG_ENABLE_FILE=False
# LOG_ENABLE_ERROR_FILE=False

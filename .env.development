# ============ FztbuCS-Project 根级环境变量（本地开发实际值）============
# 复制自 .env.example 并填入真实值；本文件含实际密钥，勿提交到仓库。
# 密钥生成：
#   openssl rand -hex 32
# 说明：本文件同时驱动根级 docker-compose.yml（db/backend/cs-website/caddy）

# ---- 数据库（docker-compose 内 db 服务）----
# PostgreSQL 主机（本地开发用 localhost）
DATABASE_HOST=localhost
# PostgreSQL 端口
DATABASE_PORT=5432
# 数据库名
DATABASE_NAME=domefff
# 数据库用户
DATABASE_USER=postgres
# 必填：PostgreSQL 密码（同时用于 db 服务初始化）
DATABASE_PASSWORD=pg_1e7e0a8969c0d107

# ---- 必填密钥 ----
# JWT 签名密钥（≥32 字节，随机生成）
SECRET_KEY=3687153a225c6fb917f1eca51585a8cc1958d03394aa24c294acea1a4a771aff
# TOTP 2FA secret 加密密钥（≥32 字节，随机生成）
TOTP_ENCRYPTION_KEY=96888d92209414017c0a4047d83ff226ea137ef57db2f0cae3603eafab2d7344

# ---- 前后端 CORS / Origin ----
# 后端 ALLOWED_ORIGINS：前端访问地址白名单（逗号分隔），默认 http://localhost:2333
# 前端 ALLOWED_ORIGINS：POST 端点 Origin/Referer 校验（防 Login CSRF）
# 两者可用同一份（前端经 Caddy 的 origin 需在此列）
ALLOWED_ORIGINS=http://localhost:2333,https://cs.yourdomain.com

# ---- 前端 ----
# Session 密钥（HMAC 签名 session token，生产必须设置 ≥32 字节）
# 生成示例：openssl rand -hex 32
AUTH_SESSION_SECRET=ca3361b11c15be28259fd3ae34d73e6461108f3a1c9a90736c0a133a96a61f56
# 站点 URL（用于 metadata base URL 与 Caddy 域名）
NEXT_PUBLIC_SITE_URL=http://localhost:2333
# 是否信任反向代理头（Caddy 后面必须为 true）
TRUST_PROXY=true

# ---- 可选 ----
# 管理员重置用户密码时使用的默认密码
PASSWORD_RESET_DEFAULT=7ed8fe242faeae0b
# 社区浏览去重 IP 哈希密钥
# COMMUNITY_IP_HASH_SECRET=
# GitHub OAuth（可选）
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=https://cs.yourdomain.com/api/auth/oauth/github/callback
# SMTP（可选，未配置验证码输出到控制台）
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@cs.yourdomain.com
# Redis（可选，不配置自动降级内存实现）
# REDIS_URL=redis://:password@redis:6379/0
# REQUIRE_REDIS_FOR_SECURITY=false

# ---- 跨实例事件广播（ADR-014，可选）----
# 多实例部署（多个 backend/worker 副本）时置 true：事件经 arq/redis 广播到所有实例，
# 每个 worker 实例在 on_startup 注册本地订阅者并落地执行。单实例保持 false 零开销。
# MULTI_INSTANCE=false
# 异步任务队列总开关（worker 是否投递到 broker；false 时就地 eager 执行）
# QUEUE_ENABLED=true

# ---- 学习助手 Auxilio LLM（0.9.8 新增，可选）----
# 不配置时默认 LLM_PROVIDER=none，Auxilio 降级为纯规则推荐模式，不发起外部请求
# LLM_PROVIDER=
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT=60
# LLM_MAX_TOKENS=1024
# LLM_DAILY_BUDGET=200

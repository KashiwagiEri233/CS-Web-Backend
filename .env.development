# 开发环境配置（.env.development）
# `python run.py`（不带参数）默认加载本文件。
# 本文件是**最全的参考样板**：所有可配字段都在此列出；新增配置项必须同步到这里。
# 复制为 .env 使用：cp .env.development .env

# ============ 数据库（开发，专属库 domefff）============
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=domefff
DATABASE_USER=postgres
# 本地开发占位：请改成本机真实密码；勿把真实生产凭据提交进仓库
DATABASE_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_LOCAL_DB_PASSWORD@localhost/domefff
# 连接池（开发可保持默认；与 Settings DB_POOL_* 对齐）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=True
# Schema 一律 Alembic（create_all 已废弃）
# DB_AUTO_CREATE=False
# 仅在库不存在时自动 CREATE DATABASE（建空库），建表交给 alembic。
DB_AUTO_CREATE_DATABASE=True
DB_MAINTENANCE_DB=postgres
# 启动时自动 alembic upgrade head。开发单进程建议 True。
DB_AUTO_MIGRATE=True

# ============ 应用 ============
PROJECT_NAME=FastAPI RBAC Framework
API_V1_STR=/api/v1
# 应用统一时区（IANA 名称）。影响：展示层（日志、错误响应 timestamp）按此时区呈现。
# 存储层（数据库、JWT）一律 UTC。留空 / UTC = UTC（默认）。示例：Asia/Shanghai
# 注意：非 UTC 时区依赖 tzdata 包（见 requirements.txt）；缺失会启动报"时区非法"。
TIMEZONE=Asia/Shanghai
DEBUG=True
TESTING=False
# 一键鉴权开关：False=跳过所有鉴权，所有接口视为超级用户（仅本地开发）
# 安全约束：DEBUG=False 时置 False 会拒绝启动
AUTH_ENABLED=True

# ============ JWT ============
# 生成安全密钥: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 至少 32 UTF-8 字节；仅本地开发用，生产必须重新生成
SECRET_KEY=dev-only-not-for-production-change-me-32b
# 密钥轮换：旧 SECRET_KEY 逗号分隔，校验时回退（开发一般留空）
JWT_PREVIOUS_SECRET_KEYS=
ALGORITHM=HS256
JWT_ISSUER=fastapi-witchcat-framework
JWT_AUDIENCE=fastapi-witchcat-api
JWT_ACCEPT_LEGACY_TOKENS=False
PERSIST_CLIENT_ERRORS=False
EXCEPTION_LOG_RETENTION_DAYS=30
EXCEPTION_LOG_CLEANUP_INTERVAL_SECONDS=86400
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# access token 黑名单后端降级：memory=回退进程内(默认) / open=Redis故障时放行(不推荐)
TOKEN_BLACKLIST_FALLBACK=memory
REQUIRE_REDIS_FOR_SECURITY=False
# 过期/已撤销 refresh 清理间隔（秒）；0=禁用
REFRESH_TOKEN_GC_INTERVAL_SECONDS=3600

# ============ 默认管理员（首次初始化创建）============
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# 首次创建管理员时必须配置；密码不写日志
# 首次 seed 管理员密码；请改成私有本地值
ADMIN_PASSWORD=CHANGE_ME_LOCAL_ADMIN

# ============ CORS ============
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=*
# 本地无反向代理，留空即不信任客户端伪造的转发头
TRUSTED_PROXY_CIDRS=

# ============ 速率限制（开发可放宽）============
RATE_LIMIT_CALLS=100
RATE_LIMIT_PERIOD=60
AUTH_RATE_LIMIT_CALLS=5
AUTH_RATE_LIMIT_PERIOD=60

# ============ Redis（限流/缓存分布式后端，可降级）============
# 本地默认连接，无密码；若本机未起 Redis，会自动降级为内存模式（仅一条 warning，不阻断启动）。
# 用 127.0.0.1 而非 localhost：Windows 上 localhost 优先解析到 IPv6 ::1，
#   而 Redis 默认只监听 IPv4(0.0.0.0)，叠加 REDIS_SOCKET_TIMEOUT=0.5 会直接 "Timeout connecting"。
# 带密码写法：redis://:yourpassword@127.0.0.1:6379/0
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SOCKET_TIMEOUT=0.5
# Redis 不可用时：memory=降级内存(默认) / open=直接放行
RATE_LIMIT_FALLBACK=memory
RATE_LIMIT_REDIS_RETRY_INTERVAL=5.0
# 缓存降级：memory=退回进程内(默认) / off=不命中且不写入
CACHE_FALLBACK=memory

# ============ 异步任务队列（arq，可选模块，默认关闭）============
# 由队列模块自读（不在核心 Settings）。True 需另装 requirements-queue.txt 并起 worker，见 docs/system/queue.md
QUEUE_ENABLED=False

# ============ 可观测性（OpenTelemetry，可选，默认关闭）============
OTEL_ENABLED=False
OTEL_SERVICE_NAME=fastapi-rbac-framework
# OTLP collector 端点；留空+启用=降级控制台导出
# OTLP collector；留空+启用=降级控制台（与 Settings 字段同名，便于检索）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER_RATIO=1.0
OTEL_CONSOLE_EXPORT=False

# ============ 日志（开发级）============
# LOG_PROFILE=dev 自动设置：DEBUG + 彩色控制台 + 完整回溯栈 + 无文件
# 注释掉的字段用 dev 默认值；取消注释则覆盖
LOG_PROFILE=dev
LOG_DIR=logs
LOG_ROTATION=10 MB
LOG_RETENTION=30 days
# LOG_LEVEL=DEBUG
# LOG_SERIALIZE=False
# LOG_BACKTRACE=True
# LOG_ENABLE_CONSOLE=True
# LOG_ENABLE_FILE=False
# LOG_ENABLE_ERROR_FILE=False


# ---- 站点 / 业务配置（前后端分离迁移 Phase 1） ----
SITE_URL=http://localhost:2333
# 生成安全密钥: python -c "import secrets; print(secrets.token_urlsafe(32))"
TOTP_ENCRYPTION_KEY=CHANGE_ME_TOTP_ENCRYPTION_KEY_DEV
TOTP_ISSUER=FZTBUCS
PASSWORD_RESET_DEFAULT=CHANGE_ME_RESET_PASSWORD_DEV
# SMTP_HOST 留空 = 验证码输出到控制台
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=False
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@fztbu.example
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=

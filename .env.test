# 测试环境配置（.env.test）
# `python run.py --env 2` 或测试相关流程加载。使用独立库 fff_test。
# 字段与 Settings 对齐；未列出的会走代码默认值。

# ============ 数据库（测试库）============
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=fff_test
DATABASE_USER=postgres
DATABASE_PASSWORD=123456
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost/fff_test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=True
# Schema 一律 Alembic
DB_AUTO_CREATE=False
DB_AUTO_CREATE_DATABASE=True
DB_MAINTENANCE_DB=postgres
DB_AUTO_MIGRATE=True

# ============ 应用 ============
PROJECT_NAME=FastAPI RBAC Framework Test
API_V1_STR=/api/v1
TIMEZONE=UTC
DEBUG=True
AUTH_ENABLED=True

# ============ JWT ============
SECRET_KEY=test-secret-key-change-in-production
JWT_PREVIOUS_SECRET_KEYS=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
TOKEN_BLACKLIST_FALLBACK=memory
# 测试关闭 GC 后台任务，避免干扰
REFRESH_TOKEN_GC_INTERVAL_SECONDS=0

# ============ 默认管理员 ============
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# ============ CORS ============
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=*

# ============ 限流（测试可放宽）============
RATE_LIMIT_CALLS=1000
RATE_LIMIT_PERIOD=60
AUTH_RATE_LIMIT_CALLS=100
AUTH_RATE_LIMIT_PERIOD=60

# ============ Redis（测试默认不连，走内存）============
# REDIS_URL=
REDIS_SOCKET_TIMEOUT=0.5
RATE_LIMIT_FALLBACK=memory
RATE_LIMIT_REDIS_RETRY_INTERVAL=5.0
CACHE_FALLBACK=memory

# ============ 队列 / OTel（测试关闭）============
QUEUE_ENABLED=False
OTEL_ENABLED=False
OTEL_SERVICE_NAME=fastapi-rbac-framework-test
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER_RATIO=1.0
OTEL_CONSOLE_EXPORT=False

# ============ 日志 ============
LOG_PROFILE=dev
LOG_DIR=logs
LOG_ROTATION=10 MB
LOG_RETENTION=7 days
# LOG_LEVEL=DEBUG
# LOG_SERIALIZE=False
# LOG_BACKTRACE=True
# LOG_ENABLE_CONSOLE=True
# LOG_ENABLE_FILE=False
# LOG_ENABLE_ERROR_FILE=False

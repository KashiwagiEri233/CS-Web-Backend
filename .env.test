# 测试数据库配置 - 使用独立的测试数据库
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=fff_test
DATABASE_USER=postgres
DATABASE_PASSWORD=123456
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost/fff_test

# JWT 配置
SECRET_KEY=test-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 应用配置
DEBUG=True
API_V1_STR=/api/v1
PROJECT_NAME=FastAPI RBAC Framework Test

# 日志配置 - 测试级（开发级 profile，DEBUG + 控制台）
LOG_PROFILE=dev
LOG_DIR=logs
LOG_ROTATION=10 MB
LOG_RETENTION=30 days
# LOG_LEVEL=DEBUG
# LOG_SERIALIZE=False
# LOG_BACKTRACE=True
# LOG_ENABLE_CONSOLE=True
# LOG_ENABLE_FILE=False
# LOG_ENABLE_ERROR_FILE=False
# 构建上下文裁剪：只让 Dockerfile 需要的文件进入镜像层
# 尤其注意 .env* —— 密钥必须由运行时环境变量注入，绝不能烘进镜像

.env
.env.*
!.env.example

.git
.gitignore
.gitattributes

__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

.pytest_cache/
.mypy_cache/
.coverage
.coveragerc
htmlcov/
build/
tests/

docs/
*.md
!README.md

logs/
*.log
*.db
*.sqlite3

.vscode/
.idea/
.codebuddy/
.codex/
.agents/

Dockerfile
.dockerignore
docker-compose*.yml
Jenkinsfile

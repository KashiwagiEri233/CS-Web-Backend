# 本地默认环境（可被 run.py --env 覆盖）
# 本文件含本机密钥/密码，勿提交；模板见 .env.example / .env.development

# ============ 数据库 ============
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=domefff
DATABASE_USER=postgres
DATABASE_PASSWORD=123456
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/domefff
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=True
DB_AUTO_CREATE=False
DB_AUTO_CREATE_DATABASE=True
DB_MAINTENANCE_DB=postgres
DB_AUTO_MIGRATE=True

# ============ 应用 ============
PROJECT_NAME=FastAPI RBAC Framework
API_V1_STR=/api/v1
TIMEZONE=Asia/Shanghai
DEBUG=True
AUTH_ENABLED=True

# ============ JWT ============
SECRET_KEY=egCotXs85wK1BB8iqlkv_wOuuZXrTShwGjobsGuPLio
JWT_PREVIOUS_SECRET_KEYS=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
TOKEN_BLACKLIST_FALLBACK=memory
REFRESH_TOKEN_GC_INTERVAL_SECONDS=3600

# ============ 默认管理员 ============
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# ============ CORS ============
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=*

# ============ 限流 ============
RATE_LIMIT_CALLS=100
RATE_LIMIT_PERIOD=60
AUTH_RATE_LIMIT_CALLS=5
AUTH_RATE_LIMIT_PERIOD=60

# ============ Redis ============
# REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SOCKET_TIMEOUT=0.5
RATE_LIMIT_FALLBACK=memory
RATE_LIMIT_REDIS_RETRY_INTERVAL=5.0
CACHE_FALLBACK=memory

# ============ 队列 / OTel ============
QUEUE_ENABLED=False
OTEL_ENABLED=False
OTEL_SERVICE_NAME=fastapi-rbac-framework
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER_RATIO=1.0
OTEL_CONSOLE_EXPORT=False

# ============ 日志 ============
LOG_PROFILE=dev
LOG_DIR=logs
LOG_ROTATION=10 MB
LOG_RETENTION=30 days
